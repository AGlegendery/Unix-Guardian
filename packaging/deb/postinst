#!/bin/sh
# Starts the daemon now and at boot, and enables the agent for every user
# (it starts at each user's next login; `systemctl --user start ug-agent`
# starts it at once).
set -e
if [ "$1" = configure ] && [ -d /run/systemd/system ]; then
  systemctl daemon-reload || true
  systemctl reload dbus.service 2>/dev/null || true
  systemctl enable unix-guardiand.service || true
  systemctl restart unix-guardiand.service || true
  systemctl --global enable ug-agent.service || true
fi
if command -v gtk-update-icon-cache >/dev/null; then
  gtk-update-icon-cache -q -t /usr/share/icons/hicolor || true
fi
exit 0
