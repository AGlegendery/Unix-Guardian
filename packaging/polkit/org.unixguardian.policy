<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  Installed to /usr/share/polkit-1/actions/.

  Every action here is checked by at least one daemon method, and every action
  the daemon checks is here; ug-daemon's tests fail if the two drift apart.
  New actions arrive with the phase that first enforces them.
-->
<policyconfig>
  <vendor>Unix Guardian</vendor>
  <vendor_url>https://github.com/unix-guardian/unix-guardian</vendor_url>
  <icon_name>unix-guardian</icon_name>

  <!--
    Game mode runs by itself when a game starts, so a password prompt here
    would appear in the middle of launching a game. Active local sessions are
    therefore allowed without one — the same trust Feral's GameMode grants —
    and everything it changes is temporary and reverted automatically.
    Remote and inactive sessions still need an administrator.
  -->
  <action id="org.unixguardian.gamemode">
    <description>Apply game mode while a game runs</description>
    <description xml:lang="fa">اعمال حالت گیمینگ در زمان اجرای بازی</description>
    <message>Authentication is required to apply game mode.</message>
    <message xml:lang="fa">برای اعمال حالت گیمینگ احراز هویت لازم است.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <!--
    The same trust logind gives: an active local user may shut down, restart
    or suspend their own machine without a password. Others need an
    administrator.
  -->
  <action id="org.unixguardian.power.control">
    <description>Shut down, restart or suspend the computer, now or on a schedule</description>
    <description xml:lang="fa">خاموش، ری‌استارت یا خواب‌کردن کامپیوتر، همین حالا یا زمان‌بندی‌شده</description>
    <message>Authentication is required to control the computer's power.</message>
    <message xml:lang="fa">برای کنترل خاموش و روشن شدن کامپیوتر احراز هویت لازم است.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="org.unixguardian.net.control">
    <description>Block an app's internet access, or limit its upload or download speed</description>
    <description xml:lang="fa">بستن اینترنت یک برنامه، یا محدود کردن سرعت آپلود یا دانلودش</description>
    <message>Authentication is required to change internet rules for apps.</message>
    <message xml:lang="fa">برای تغییر قوانین اینترنت برنامه‌ها احراز هویت لازم است.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <!--
    GPU tuning can make a machine unstable, so it asks for the administrator
    password once and remembers it for a few minutes. Every change is a
    30-second trial that undoes itself unless kept.
  -->
  <action id="org.unixguardian.gpu.tune">
    <description>Change a graphics card's power limit or clock offsets</description>
    <description xml:lang="fa">تغییر سقف توان یا آفست کلاک کارت گرافیک</description>
    <message>Authentication is required to tune the graphics card.</message>
    <message xml:lang="fa">برای تنظیم کارت گرافیک احراز هویت لازم است.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="org.unixguardian.cooling">
    <description>Change fan curves or the laptop's fan mode</description>
    <description xml:lang="fa">تغییر کرو فن یا حالت فن لپ‌تاپ</description>
    <message>Authentication is required to change how the fans run.</message>
    <message xml:lang="fa">برای تغییر نحوه‌ی کار فن‌ها احراز هویت لازم است.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="org.unixguardian.daemon.debug">
    <description>Change Unix Guardian diagnostic settings</description>
    <description xml:lang="fa">تغییر تنظیمات عیب‌یابی Unix Guardian</description>
    <message>Authentication is required to change Unix Guardian's log level.</message>
    <message xml:lang="fa">برای تغییر سطح لاگ Unix Guardian احراز هویت لازم است.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
